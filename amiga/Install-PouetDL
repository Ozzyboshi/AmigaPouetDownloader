; Install-PouetDL
;
; Installation script for Commodore Installer 43.x / InstallerLG
; Target: AmigaOS 2.04 (V37) and above
;
; $VER: Install-PouetDL 1.0 (15.8.2026)
;
; ---------------------------------------------------------------------------
; EXPECTED FLOPPY LAYOUT
;
; Source paths below are relative to the drawer holding this script, which
; is the current directory when Workbench launches the Installer.
;
;   PouetDL:
;     Install-PouetDL
;     Install-PouetDL.info   <- Default Tool = Installer
;     Installer              <- Installer 43.3 binary, in root
;     Disk.info
;     pouet.rexx
;     c/
;       adf_extract
;       parse_prod
;       pouet_party
;       pouet_lastid
;       wget                 <- copied to C: only if not on the path
;     libs/
;       usergroup.library    <- needed by wget, copied together with it
;
; ---------------------------------------------------------------------------
; WHY THINGS GO WHERE THEY GO
;
; pouet.rexx invokes its four helper commands with an explicit "c:" prefix
; (c:parse_prod, c:adf_extract, c:pouet_party, c:pouet_lastid), so putting
; them anywhere else on the path is not enough - they must live in C:.
;
; By contrast lha, unzip and xdms are invoked without a prefix, so for
; those any directory on the path will do. Directories are created by
; pouet.rexx itself through rexxsupport.library, so no mkdir is needed.
;
; The script bails out immediately with "Please assign pouet:" or
; "Please assign pouettmp:" if those two assigns are missing, so they are
; mandatory rather than optional.
;
; The proxy address is read with "getenv pouetproxy", which reads ENV:.
; ---------------------------------------------------------------------------


;=============================================================================
; 1. CONSTANTS
;=============================================================================

(set #app        "AmigaPouetDownloader")
(set #min-osver  37)                 ; 37 = OS 2.04

(set #src-rexx   "pouet.rexx")
(set #src-c      "c")
(set #src-libs   "libs")


;=============================================================================
; 2. USER-VISIBLE STRINGS
;    In a localised release these would live in a catalog and be pulled in
;    with (database "language") plus per-language string sets.
;=============================================================================

(set #welcome
  (cat "Welcome to the " #app " installation.\n\n"
       "It installs pouet.rexx with its helper commands, "
       "sets up the POUET: and POUETTMP: assigns and "
       "stores the proxy address."))

(set #bad-os
  "AmigaPouetDownloader requires AmigaOS 2.04 (V37) or higher.")

; Prompts are kept to two or three short lines: the Installer window has a
; fixed size and text that does not fit is drawn over the gadgets below it.
; Anything longer belongs in the matching -help string.

; --- REXX: destination ------------------------------------------------------
(set #ask-rexx
  "Where should pouet.rexx go?\nPick the drawer REXX: points at.")

(set #ask-rexx-help
  (cat "pouet.rexx has to end up in the directory the REXX: assign "
       "points at, otherwise \"rx pouet\" will not find it.\n\n"
       "On a standard system REXX: points at S:. If your system has no "
       "REXX: assign, pick a drawer anyway and remember to create the "
       "assign yourself.\n\n"
       "The file name must stay pouet.rexx, because rx appends the .rexx "
       "extension to the name you give it on the command line.\n\n"
       @askdir-help))

; --- C: destination ---------------------------------------------------------
(set #ask-cdir
  "Where should the helper commands go?\nThey must be in C: to work.")

(set #ask-cdir-help
  (cat "adf_extract, parse_prod, pouet_party and pouet_lastid are run by "
       "the arexx script as \"c:parse_prod\", \"c:adf_extract\" and so "
       "on. Installing them elsewhere will not work even if that "
       "directory is on your path.\n\n" @askdir-help))

; --- POUET: -----------------------------------------------------------------
(set #ask-pouet
  "Where should downloads be stored (POUET:)?\nPick a hard disk (not RAM:)")

(set #ask-pouet-help
  (cat "POUET: is the root of the permanent archive. Underneath it the "
       "script builds a parties/<party>/<year>/<type>/<title> tree, so "
       "it needs real space.\n\n"
       "The arexx script exits straight away with \"Please assign "
       "pouet:\" if this assign does not exist.\n\n" @askdir-help))

; --- POUETTMP: --------------------------------------------------------------
(set #ask-tmp
  "Scratch directory (POUETTMP:)?\nRAM: is fine with 8 MB of fast ram.")

(set #ask-tmp-help
  (cat "JSON responses from pouet and downloaded archives land in "
       "POUETTMP: before being unpacked into POUET:.\n\n"
       "A ramdisk is much faster but consumes as much memory as the "
       "largest file you download, so with less than 8 MB of fast ram "
       "use a directory on a hard disk.\n\n"
       "Use bare RAM:, not a drawer inside it: that drawer is gone after "
       "a reboot and the assign in S:User-Startup would fail.\n\n"
       @askdir-help))

; --- proxy ------------------------------------------------------------------
(set #ask-proxy
  "Address of the pouet proxy\n(the PC running docker), as x.x.x.x:9999")

(set #ask-proxy-help
  (cat "The script reads this value with \"getenv pouetproxy\" and "
       "prepends it to the https URL it wants, for example:\n\n"
       "  wget -O ... 192.168.1.10:9999/https://api.pouet.net/v1/prod/?id=1\n\n"
       "Give it without a scheme, as shown in the README. wget prepends "
       "http:// by itself, because a URI scheme must start with a letter "
       "and 192.168.1.10 starts with a digit, so there is no ambiguity.\n\n"
       "The port must match the one exposed in your docker-compose.yml "
       "(9999 by default).\n\n" @askstring-help))

(set #bad-proxy
  "That proxy address is too short to be valid.\nPlease try again.")

; --- startup ----------------------------------------------------------------
(set #ask-startup
  (cat "Add the POUET: and POUETTMP: assigns\nto S:User-Startup?\n\n"
       "pouet.rexx will not run without them."))

(set #ask-startup-help
  (cat "The lines are inserted between ;BEGIN and ;END markers carrying "
       "this application's name, so reinstalling replaces the block "
       "instead of duplicating it.\n\n"
       "If you say no, add the two Assign lines to your startup yourself."))

; --- progress ---------------------------------------------------------------
(set #working-rexx  "Copying pouet.rexx...")
(set #working-c     "Copying the helper commands...")
(set #working-env   "Setting the pouetproxy variable...")


;=============================================================================
; 3. HELPER PROCEDURES
;
; Note: parameters in (procedure) are only supported from Installer 43
; onwards. These use global variables instead, which is uglier but keeps
; the script working on 42 as well.
;=============================================================================

; Write a persistent environment variable.
; Input: #ev-name, #ev-value
;
; setenv only writes to ENV:, which lives in RAM and is lost on reboot.
; Persistence comes from ENVARC:, which the Startup-Sequence copies back
; into ENV: at every boot, so the file has to be written to both.
(procedure P_SetEnvVar
  (textfile
    (dest   (tackon "ENV:" #ev-name))
    (append #ev-value)
  )
  (if (exists "ENVARC:" (noreq))
    (textfile
      (dest   (tackon "ENVARC:" #ev-name))
      (append #ev-value)
    )
  )
)

; Create a directory only if it is not already there.
; Input: #md-dir
(procedure P_MakeDirIfNeeded
  (if (= 0 (exists #md-dir (noreq)))
    (makedir #md-dir)
  )
)

; Append a line to #missing if command #chk-cmd is not present in C:.
; Input: #chk-cmd, #chk-url
(procedure P_CheckTool
  (if (= 0 (exists (tackon "C:" #chk-cmd) (noreq)))
    (set #missing (cat #missing "  " #chk-cmd "\n      " #chk-url "\n"))
  )
)


;=============================================================================
; 4. OPERATING SYSTEM CHECK
;=============================================================================

(set #osver (/ (getversion "exec.library" (resident)) 65536))

(if (< #osver #min-osver)
  (abort #bad-os)
)


;=============================================================================
; 5. QUESTIONS
;=============================================================================

(welcome #welcome)

; --- where the arexx script goes --------------------------------------------
; Offer REXX: as the default if the assign exists, otherwise fall back to S:.
(if (exists "REXX:" (noreq))
  (set #def-rexx "REXX:")
  (set #def-rexx "S:")
)

(set #rexxdir
  (askdir
    (prompt  #ask-rexx)
    (help    #ask-rexx-help)
    (default #def-rexx)
  )
)

; --- where the helper commands go -------------------------------------------
(set #cdir
  (askdir
    (prompt  #ask-cdir)
    (help    #ask-cdir-help)
    (default "C:")
  )
)

; --- permanent archive ------------------------------------------------------
(set #pouetdir
  (askdir
    (prompt  #ask-pouet)
    (help    #ask-pouet-help)
    (default @default-dest)
    (newpath)
  )
)

; --- scratch directory ------------------------------------------------------
(set #tmpdir
  (askdir
    (prompt  #ask-tmp)
    (help    #ask-tmp-help)
    (default "RAM:")
    (newpath)
  )
)

; --- proxy address ----------------------------------------------------------
; Mirror the "length(proxyaddress) < 4" test the arexx script performs, so
; an empty or nonsense value is caught here instead of at run time.
;
; There is no sensible default for this, so the question is always asked:
; in Novice mode askstring would silently take the default, so the user
; level is raised to Average around it and put back afterwards. On a
; reinstall the current value of the variable is offered as the default.
(set #proxy-default (getenv "pouetproxy"))
(if (< (strlen #proxy-default) 4)
  (set #proxy-default "192.168.1.10:9999")
)

(set #old-level (user 1))
(set #proxy "")
(while (< (strlen #proxy) 4)
  (
    (set #proxy
      (askstring
        (prompt  #ask-proxy)
        (help    #ask-proxy-help)
        (default #proxy-default)
      )
    )
    (if (< (strlen #proxy) 4)
      (message #bad-proxy)
    )
  )
)
(user #old-level)

; Tell the Installer where things ended up, for its own final message.
(set @default-dest #pouetdir)


;=============================================================================
; 6. FILE INSTALLATION
;=============================================================================

(complete 10)

; --- the arexx script -------------------------------------------------------
(working #working-rexx)
(copyfiles
  (prompt  "Copying pouet.rexx to " #rexxdir)
  (help    @copyfiles-help)
  (source  #src-rexx)
  (dest    #rexxdir)
)

(complete 25)

; --- the four helper commands -----------------------------------------------
; (choices) names them explicitly rather than using (all), so that any
; stray file left in c/ during development does not get installed.
(working #working-c)
(copyfiles
  (prompt  "Copying the helper commands to " #cdir)
  (help    @copyfiles-help)
  (source  #src-c)
  (dest    #cdir)
  (choices "adf_extract"
           "parse_prod"
           "pouet_party"
           "pouet_lastid")
)

(complete 50)

; --- make sure the assign targets exist -------------------------------------
(set #md-dir #pouetdir)
(P_MakeDirIfNeeded)

(set #md-dir #tmpdir)
(P_MakeDirIfNeeded)

(complete 60)


;=============================================================================
; 7. ENVIRONMENT VARIABLE
;=============================================================================

(working #working-env)

(set #ev-name  "pouetproxy")
(set #ev-value #proxy)
(P_SetEnvVar)

(complete 75)


;=============================================================================
; 8. ASSIGNS IN S:User-Startup
;
; (startup) inserts the lines between
;     ;BEGIN AmigaPouetDownloader ... ;END AmigaPouetDownloader
; replacing any existing block carrying the same name, which is what makes
; reinstallation safe. Never append to User-Startup by hand from a script.
;=============================================================================

(if (askbool
      (prompt  #ask-startup)
      (help    #ask-startup-help)
      (default 1)
    )
  (startup #app
    (prompt "Adding the POUET: and POUETTMP: assigns to S:User-Startup")
    (help   #ask-startup-help)
    (command
      (cat "Assign >NIL: POUET: \""    #pouetdir "\"\n"
           "Assign >NIL: POUETTMP: \"" #tmpdir   "\"\n"))
  )
)

; Make the assigns available right now, so the user can try the script
; without rebooting first. These are skipped in PRETEND mode unless
; (safe) is added, so they will not show up in a dry-run log.
(run (cat "Assign >NIL: POUET: \""    #pouetdir "\""))
(run (cat "Assign >NIL: POUETTMP: \"" #tmpdir   "\""))

(complete 90)


;=============================================================================
; 9. EXTERNAL DEPENDENCY CHECK
;
; wget is the only one we ship: if it is not on the path, the copy in c/
; goes to C: and the usergroup.library it needs goes to LIBS:. None of the
; others can be redistributed on this floppy, so all we can do is report
; which ones are missing and where to get them.
;=============================================================================

; Which, unlike P_CheckTool, looks along the whole path, so a wget the user
; already has somewhere else is left alone. It returns WARN when the command
; is not found. (safe) runs it in PRETEND mode too.
; usergroup.library goes in with copyfiles, and only if LIBS: does not
; already have one, so an existing copy is never replaced. Not copylib:
; InstallerLG's getversion reads 0 from this library, and copylib then
; silently copies nothing even when the destination is missing.
(set #need-wget (<> 0 (run "Which >NIL: wget" (safe))))

(if #need-wget
  (copyfiles
    (prompt  "wget was not found on the path, copying the bundled one to C:")
    (help    @copyfiles-help)
    (source  #src-c)
    (dest    "C:")
    (choices "wget")
  )
)

(if (and #need-wget (= 0 (exists "LIBS:usergroup.library" (noreq))))
  (copyfiles
    (prompt  "Copying usergroup.library, needed by wget, to LIBS:")
    (help    @copyfiles-help)
    (source  #src-libs)
    (dest    "LIBS:")
    (choices "usergroup.library")
  )
)

(set #missing "")

(set #chk-cmd "lha")
(set #chk-url "https://aminet.net/package/util/arc/lha")
(P_CheckTool)

(set #chk-cmd "unzip")
(set #chk-url "http://aminet.net/package/util/arc/UnZip")
(P_CheckTool)

(set #chk-cmd "xdms")
(set #chk-url "http://aminet.net/package/util/arc/xDMS")
(P_CheckTool)

(if (> (strlen #missing) 0)
  (message
    (cat "These commands were not found in C:\n"
         "and must be installed by hand:\n\n"
         #missing "\n"
         "Ignore this if they are elsewhere on your path."))
)

(complete 100)


;=============================================================================
; 10. DONE
;=============================================================================

(message
  (cat "Installation complete.\n\n"
       "POUET: " #pouetdir "\n"
       "POUETTMP: " #tmpdir "\n"
       "pouetproxy: " #proxy "\n\n"
       "With RexxMast running, from a Shell:\n"
       "  rx pouet 93426\n"
       "  rx pouet party 1550 2016"))

(exit (quiet))


